enum LivenessStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

model LivenessVerification {
  id                   String         @id @default(cuid())
  userId               String         @unique
  status               LivenessStatus @default(NOT_SUBMITTED)
  liveSelfieObjectKey  String?
  similarity           Decimal?       @db.Decimal(5, 2)
  clientLivenessPassed Boolean        @default(false)
  challengesPassed     Json?
  autoDecision         String?
  reviewNote           String?        @db.Text
  rejectionReason      String?        @db.Text
  attemptCount         Int            @default(0)
  attemptWindowStart   DateTime?
  submittedAt          DateTime?
  reviewedAt           DateTime?
  reviewerId           String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PayoutProfile {
  id                   String    @id @default(cuid())
  userId               String    @unique
  mpesaPhone           String?
  phoneVerifiedAt      DateTime?
  destinationChangedAt DateTime?
