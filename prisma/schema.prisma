  createdAt  DateTime @default(now())
  follower   User     @relation("FollowSender", fields: [followerId], references: [id], onDelete: Cascade)
  followed   User     @relation("FollowReceiver", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followedId])
}

model VideoLike {
  id         String     @id @default(cuid())
  senderId   String
  receiverId String
  mediaId    String?
  isNew      Boolean    @default(true)
  createdAt  DateTime   @default(now())
  sender     User       @relation("LikeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User       @relation("LikeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  media      UserMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@unique([senderId, mediaId])
  @@index([receiverId, createdAt])
}

model VideoComment {
  attachmentUrl  String? @db.Text
  attachmentKind String?
  id        String         @id @default(cuid())
  mediaId   String
  authorId  String
  text      String         @db.Text
  parentId  String?
  likes     Int            @default(0)
  isPinned  Boolean        @default(false)
  isHidden  Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  media     UserMedia      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  author    User           @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    VideoComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   VideoComment[] @relation("CommentReplies")
  likedBy   CommentLike[]

  @@index([mediaId, createdAt])
  @@index([mediaId, isPinned, createdAt])
  @@index([mediaId, isHidden, isPinned, createdAt])
  @@index([parentId])
  @@index([authorId])
}

model CommentLike {
  id        String       @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime     @default(now())
  comment   VideoComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User         @relation("CommentLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model UserSwipe {
  id         String         @id @default(cuid())
  senderId   String
  receiverId String
  direction  SwipeDirection @default(RIGHT)
  createdAt  DateTime       @default(now())
  sender     User           @relation("SwipeSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User           @relation("SwipeReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId])
}

model DiscoverSeen {
  id      String   @id @default(cuid())
  userId  String
  mediaId String
  seenAt  DateTime @default(now())

  @@unique([userId, mediaId])
  @@index([userId])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("BlockSender", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockReceiver", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserMatch {
  id        String   @id @default(cuid())
  userAId   String
  userBId   String
  isNewForA Boolean  @default(true)
  isNewForB Boolean  @default(true)
  createdAt DateTime @default(now())
  userA     User     @relation("MatchSender", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchReceiver", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, createdAt])
}

model ChatThread {
  id                  String            @id @default(cuid())
  kind                ChatThreadKind    @default(DIRECT)
  selfOwnerId         String?           @unique
  broadcastOnly       Boolean           @default(false)
  campaignId          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastMessageText     String?           @db.Text
  lastMessageType     ChatMessageType?
  lastMessageAt       DateTime?
  // Credits gating: the participant who sent the first message (the paying
  // "user"); the other party's replies are charged to them.
  // `unlockedAt` is the start of the current fixed 24h access grant — set
  // (and refreshed) every time a Key is spent. While now() - unlockedAt < 24h
  // AND the initiator has ChatCredits, replies auto-deduct and arrive
  // unlocked; otherwise a reply is locked and needs a Key to open, which
  // refreshes this window. `icebreakerUnlocked` is kept only as a legacy
  // "has this thread ever been unlocked at least once" marker.
  initiatorId         String?
  icebreakerUnlocked  Boolean           @default(false)
  unlockedAt          DateTime?
  cycleStartedAt      DateTime?
  cycleIcebreakerId   String?
  cycleLockedReplyId  String?
  entityChatEndedAt   DateTime?
  entityChatEndedById String?
  participants        ChatParticipant[]
  messages            ChatMessage[]
  hiddenBy            UserHiddenChat[]
  hideRequests        ChatHideRequest[]
  muteSettings        ChatMute[]
  selfOwner           User?             @relation("SelfChatOwner", fields: [selfOwnerId], references: [id], onDelete: Cascade)
}

model ChatParticipant {
  id          String     @id @default(cuid())
  threadId    String
  userId      String
  otherUserId String?
  archived    Boolean    @default(false)
  anonymous   Boolean    @default(false)
  unreadCount Int        @default(0)
  clearedAt   DateTime?
  joinedAt    DateTime   @default(now())
  thread      ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, otherUserId])
}

model PrivateCodeRecovery {
  userId String @id
  encryptedToken String @db.Text
  issuedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatPrivateCodeGroup {
  encryptedRecoveryPin String? @db.Text
  id          String                @id @default(cuid())
  userId      String
  purpose     PrivateCodePurpose
  codeHash    String                @db.Char(64)
  createdAt   DateTime              @default(now())
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hiddenChats UserHiddenChat[]
  messages    SecureFolderMessage[]
  folders     VaultFolder[]

  @@unique([userId, purpose, codeHash])
  @@index([userId, purpose])
}

model UserHiddenChat {
  id          String               @id @default(cuid())
  userId      String
  threadId    String
  codeGroupId String
  hideForAll  Boolean              @default(false)
  hiddenAt    DateTime             @default(now())
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread      ChatThread           @relation(fields: [threadId], references: [id], onDelete: Cascade)
  codeGroup   ChatPrivateCodeGroup @relation(fields: [codeGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, codeGroupId])
  @@index([threadId])
}

model ChatHideRequest {
  id          String                @id @default(cuid())
  threadId    String
  requesterId String
  recipientId String
  action      ChatHideRequestAction
  status      ChatHideRequestStatus @default(PENDING)
  expiresAt   DateTime?
  respondedAt DateTime?
  createdAt   DateTime              @default(now())
  thread      ChatThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  requester   User                  @relation("ChatHideRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient   User                  @relation("ChatHideRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, status, createdAt])
  @@index([requesterId, threadId, createdAt])
  @@index([expiresAt, status])
}

model VaultFolder {
  id          String @id @default(cuid())
  codeGroupId String
  parentId    String?
  name        String @db.VarChar(255)
  systemKey   String? @db.VarChar(32)
  createdAt   DateTime @default(now())
  codeGroup   ChatPrivateCodeGroup @relation(fields: [codeGroupId], references: [id], onDelete: Cascade)

  @@unique([codeGroupId, systemKey])
  @@index([codeGroupId, parentId])
}

model SecureFolderMessage {
  folderId    String?
  displayName String? @db.VarChar(255)
  id          String               @id @default(cuid())
  ownerId     String
  messageId   String
  codeGroupId String
  movedAt     DateTime             @default(now())
  owner       User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message     ChatMessage          @relation(fields: [messageId], references: [id], onDelete: Cascade)
  codeGroup   ChatPrivateCodeGroup @relation(fields: [codeGroupId], references: [id], onDelete: Cascade)

  @@unique([ownerId, messageId])
  @@index([ownerId, codeGroupId, movedAt])
}

model ChatMute {
  id       String     @id @default(cuid())
  userId   String
  threadId String
  mutedAt  DateTime   @default(now())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread   ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
}

model ChatMessage {
  id                  String                @id @default(cuid())
  threadId            String
  senderId            String
  type                ChatMessageType       @default(TEXT)
  text                String?               @db.Text
  imageUrl            String?
  imageObjectKey      String?
  albumId             String?               @db.VarChar(64)
  videoUrl            String?
  videoObjectKey      String?
  thumbnailUrl        String?
  thumbnailObjectKey  String?
  documentObjectKey   String?
  documentName        String?
  documentMimeType    String?
  documentSizeBytes   Int?
  replyToId           String?
  replyToText         String?               @db.Text
  replyToSenderId     String?
  replyToSenderName   String?
  reactions           Json?
  isRead              Boolean               @default(false)
  deliveredAt         DateTime?
  pinnedAt            DateTime?
  pinnedById          String?
  // Credits gating: a reply from the non-initiator is locked until the
  // thread initiator spends a Key (first) or ChatCredit (subsequent) to unlock.
  locked              Boolean               @default(false)
  // Plaintext preview (~10 chars) captured client-side before encryption, so
  // locked E2E-encrypted messages can still show a teaser server-side.
  previewText         String?
  broadcastCampaignId String?
  // Per-user soft delete: userIds who deleted this message from THEIR OWN
  // view. Deleting your own sent message never removes it for the other
  // participant — only the deleting user's copy disappears.
  deletedForUserIds   Json?
  sentAt              DateTime              @default(now())
  thread              ChatThread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender              User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  secureCopies        SecureFolderMessage[]

  @@index([threadId, sentAt])
  @@index([threadId, senderId, deliveredAt])
  @@index([broadcastCampaignId])
}

model CreatorAvailability {
  id             String   @id @default(cuid())
  userId         String
  weekday        Int
  startMinute    Int
  endMinute      Int
  timezone       String
  voiceEnabled   Boolean  @default(true)
  videoEnabled   Boolean  @default(true)
  maxSessionsDay Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekday, isActive])
}

model CallBooking {
  id                   String        @id @default(cuid())
  customerId           String
  creatorId            String
  type                 BookingType
  status               BookingStatus @default(PROPOSED)
  timezone             String
  scheduledStart       DateTime
  scheduledEnd         DateTime
  originalStart        DateTime?
  originalEnd          DateTime?
  proposalExpiresAt    DateTime
  proposedStart        DateTime?
  proposedEnd          DateTime?
  counterProposedAt    DateTime?
  channelId            String        @unique
  customerJoinedAt     DateTime?
  creatorJoinedAt      DateTime?
  approvedAt           DateTime?
  declinedAt           DateTime?
  cancelledAt          DateTime?
  completedAt          DateTime?
  creatorFineAppliedAt DateTime?
  reminderSentAt       DateTime?
  // Marks the three-minute both-parties-joined check as done, so the late
  // notice is sent once rather than on every reconcile tick.
  lateNoticeSentAt     DateTime?
  // Marks the "your call is live, join now" notice as sent, so it goes out
  // once when the slot opens rather than on every reconcile tick.
  liveNoticeSentAt     DateTime?
  endReason            String?       @db.Text
  reviewDecision       String?
  reviewedAt           DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  customer             User          @relation("BookingCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  creator              User          @relation("BookingCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorFine          CreatorFine?
  callInvites          CallInvite[]

  @@index([creatorId, scheduledStart])
  @@index([creatorId, scheduledStart, status])
  @@index([customerId, scheduledStart, status])
  @@index([status, proposalExpiresAt])
}

