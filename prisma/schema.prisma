generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  REPORTED
  HIDDEN
}

enum LoginProvider {
  EMAIL
  PHONE
  GOOGLE
  APPLE
}

enum AccountType {
  INDIVIDUAL
  ENTITY
}

enum AdBillingMetric {
  CPC
  CPM
  CPE
}

enum AdCampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  COMPLETED
  REJECTED
}

enum AdReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum EntityPlanType {
  BUSINESS
  PREMIUM
}

enum EntityPlanInterval {
  MONTHLY
  YEARLY
}

enum MediaKind {
  PROFILE_VIDEO
  PROFILE_IMAGE
  GALLERY_VIDEO
  AVATAR_IMAGE
  IMAGE
  DOCUMENT
}

enum TagApprovalStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum PlanInterval {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WEBHOOK
}

enum NotificationStatus {
  DRAFT
  SENT
  FAILED
}

enum SwipeDirection {
  LEFT
  RIGHT
}

enum ChatMessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
  SYSTEM
  TIP
}

enum ChatThreadKind {
  DIRECT
  BROADCAST
  SELF
}

enum PrivateCodePurpose {
  HIDDEN_CHATS
  SECURE_FOLDER
}

enum ChatHideRequestAction {
  HIDE_FOR_ALL
  UNHIDE_FOR_ALL
}

enum ChatHideRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BookingType {
  VOICE
  VIDEO
}

enum BookingStatus {
  PROPOSED
  COUNTER_PROPOSED
  APPROVED
  DECLINED
  EXPIRED
  CANCELLED
  LIVE
  COMPLETED
  USER_NO_SHOW
  CREATOR_NO_SHOW
  UNDER_REVIEW
  REFUNDED
}

enum EarningSource {
  KEY
  CHAT_CREDIT
  VOICE_SESSION
  VIDEO_SESSION
  TIP
}

enum EarningLotStatus {
  PENDING
  HELD
  AVAILABLE
  RESERVED
  PAID
  REVERSED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum CreatorPayoutStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum CreatorFineStatus {
  OUTSTANDING
  SETTLED
  REVERSED
}

enum TechnicalIssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum PayoutAllocationStatus {
  RESERVED
  PAID
  RELEASED
}

enum CallInviteStatus {
  RINGING
  ANSWERED
  DECLINED
  CANCELLED
  MISSED
}

enum PaymentProvider {
  MPESA
  STRIPE
  GOOGLE_PLAY
  APP_STORE
}

enum PaymentPurpose {
  CREDIT_PURCHASE
  TIP
  PAYOUT
}

enum PaymentAttemptStatus {
  CREATED
  SUBMITTING
  PENDING
  VERIFYING
  FULFILLING
  SUCCEEDED
  FAILED
  CANCELLED
  REQUIRES_REVIEW
}

enum TipRequestStatus {
  PENDING
  SENT
  COMPLETED
  CANCELLED
}

enum MpesaRequestStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
}

enum VerificationChannel {
  SMS
  EMAIL
}

enum VerificationPurpose {
  PHONE_LOGIN
  PASSWORD_RESET
  PAYOUT_PHONE
}

model User {
  privateCodeRecovery PrivateCodeRecovery? 
  id                        String                   @id @default(cuid())
  externalId                String?                  @unique
  fullName                  String
  nameChangeCount           Int       @default(0)
  lastNameChangedAt         DateTime?
  nameHistoryStartedAt      DateTime  @default(now())
  username                  String?                  @unique
  gender                    String
  birthday                  DateTime?
  email                     String?                  @unique
  analyticsReportSchedule   AnalyticsReportSchedule?
  analyticsEvents           AccountAnalyticsEvent[]
  passwordHash              String?
  phoneNumber               String?                  @unique
  role                      UserRole                 @default(USER)
  avatarUrl                 String?
  isActive                  Boolean                  @default(true)
  lastLoginAt               DateTime?
  bio                       String?                  @db.Text
  deviceToken               String?
  deviceSystem              String?
  notificationPreferences   Json?
  swipeCount                Int                      @default(0)
  verified                  Boolean                  @default(false)
  lastSwipeDate             DateTime?
  status                    UserStatus               @default(ACTIVE)
  loginProvider             LoginProvider            @default(EMAIL)
  accountType               AccountType              @default(INDIVIDUAL)
  physicalAddress           String?
  officialPhoneNumber       String?
  officialEmail             String?
  websiteUrl                String?
  entityDocuments           Json?
  entityDocumentReview      Json?
  entityVerification        EntityVerificationStatus @default(NOT_SUBMITTED)
  entityBadgeColor          String?
  entityPublishedAt         DateTime?
  entityPlanType            EntityPlanType?
  entityPlanInterval        EntityPlanInterval?
  entityPlanStartedAt       DateTime?
  entityPlanExpiresAt       DateTime?
  entityCallDurationMinutes Int                      @default(15)
  entityCallBufferMinutes   Int                      @default(5)
  country                   String?
  city                      String?
  // Preferred content language (ISO code, e.g. "en"/"sw") set at signup and
  // editable in profile. Used to bias which creators are suggested in Discover.
  language                  String                   @default("en")
  latitude                  Decimal?                 @db.Decimal(10, 7)
  longitude                 Decimal?                 @db.Decimal(10, 7)
  interests                 Json?
  links                     Json?
  filter                    Json?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  lastActiveAt              DateTime?
  showLastActivity          Boolean                  @default(true)
  allowPostDownloads        Boolean                  @default(true)
  deactivatedAt             DateTime?
  scheduledDeletionAt       DateTime?
  accountPurgedAt           DateTime?
  earningSuspendedUntil     DateTime?
  callsRestrictedUntil      DateTime?
  // Creator preference: approve incoming booking proposals automatically
  // instead of leaving them PROPOSED for a manual tap. Off by default, since
  // auto-committing someone's time is not a safe assumption to make for them.
  availabilityConfigured    Boolean                  @default(false)
  autoAcceptBookings        Boolean                  @default(false)
  activeStrikeCount         Int                      @default(0)
  media                     UserMedia[]
  reportsMade               Report[]                 @relation("ReportReporter")
  reportsAgainst            Report[]                 @relation("ReportTarget")
  technicalIssues           TechnicalIssue[]
  notificationCampaigns     NotificationCampaign[]   @relation("NotificationCreatedBy")
  adCampaigns               AdCampaign[]            @relation("AdCampaignOwner")
  notifications             UserNotification[]       @relation("UserNotificationRecipient")
  sentNotifications         UserNotification[]       @relation("UserNotificationSender")
  walletEntries             WalletTransaction[]
  withdrawals               WithdrawalRequest[]
  creditAccount             CreditAccount?
  autoTopupConfig           AutoTopupConfig?
  creditEntries             CreditLedger[]           @relation("CreditLedgerUser")
  creditPurchases           CreditPurchase[]
  tipPurchases              TipPurchase[]            @relation("TipPurchaseSender")
  receivedTipPurchases      TipPurchase[]            @relation("TipPurchaseReceiver")
  sentTips                  Tip[]                    @relation("TipSender")
  receivedTips              Tip[]                    @relation("TipReceiver")
  sentFollows               Follow[]                 @relation("FollowSender")
  receivedFollows           Follow[]                 @relation("FollowReceiver")
  sentLikes                 VideoLike[]              @relation("LikeSender")
  receivedLikes             VideoLike[]              @relation("LikeReceiver")
  sentSwipes                UserSwipe[]              @relation("SwipeSender")
  receivedSwipes            UserSwipe[]              @relation("SwipeReceiver")
  blockedUsers              UserBlock[]              @relation("BlockSender")
  blockedByUsers            UserBlock[]              @relation("BlockReceiver")
  sentMatches               UserMatch[]              @relation("MatchSender")
  receivedMatches           UserMatch[]              @relation("MatchReceiver")
  chatParticipants          ChatParticipant[]
  selfChatThread            ChatThread?              @relation("SelfChatOwner")
  privateCodeGroups         ChatPrivateCodeGroup[]
  hiddenChats               UserHiddenChat[]
  secureFolderMessages      SecureFolderMessage[]
  chatMuteSettings          ChatMute[]
  requestedChatHideChanges  ChatHideRequest[]        @relation("ChatHideRequester")
  receivedChatHideChanges   ChatHideRequest[]        @relation("ChatHideRecipient")
  sentMessages              ChatMessage[]            @relation("ChatMessageSender")
  sentTipRequests           TipRequest[]             @relation("TipRequestSender")
  receivedTipRequests       TipRequest[]             @relation("TipRequestReceiver")
  mpesaRequests             MpesaPaymentRequest[]
  verificationCodes         VerificationCode[]
  providerAccounts          ProviderAccount[]
  videoComments             VideoComment[]           @relation("CommentAuthor")
  commentLikes              CommentLike[]            @relation("CommentLikeUser")
  creatorAvailability       CreatorAvailability[]
  customerBookings          CallBooking[]            @relation("BookingCustomer")
  creatorBookings           CallBooking[]            @relation("BookingCreator")
  creatorStrikes            CreatorStrike[]
  creatorFines              CreatorFine[]
  earningLots               EarningLot[]
  kycProfile                CreatorKyc?
  accountVerification       AccountVerification?
  payoutProfile             PayoutProfile?
  creatorPayouts            CreatorPayout[]
  paymentAttempts           PaymentAttempt[]
  livenessVerification      LivenessVerification?
  savedVideos               SavedVideo[]
  hiddenMedia               HiddenMedia[]
  mediaReposts              MediaRepost[]
  e2eKey                    UserKey?
  deviceInstallations       DeviceInstallation[]
  outgoingCallInvites       CallInvite[]             @relation("CallInviteCaller")
  incomingCallInvites       CallInvite[]             @relation("CallInviteCallee")

  @@index([scheduledDeletionAt, accountPurgedAt])
  @@index([accountType, entityVerification, entityPublishedAt])
  @@map("users")
}

model AdCampaign {
  isTest Boolean @default(false)
  testViewerIds Json?
  publishedAt DateTime?
  id          String           @id @default(cuid())
  ownerId     String
  name        String
  caption     String?          @db.Text
  mediaUrls   Json?
  websiteUrl  String?
  ctaLabel    String?
  language    String           @default("en") @db.VarChar(64)
  countries   Json?
  subjects    Json?
  startDate   DateTime?
  endDate     DateTime?
  isBoost     Boolean          @default(false)
  checkoutPaid Boolean         @default(false)
  autoRenew Boolean            @default(false)
  sourceMediaId String?
  creative Json?
  budgetMicros BigInt          @default(0)
  fundedMicros BigInt          @default(0)
  spentMicros BigInt           @default(0)
  dailyBudgetMicros BigInt      @default(0)
  pacingTokensMicros BigInt     @default(0)
  pacingSpentMicros BigInt      @default(0)
  pacingUpdatedAt DateTime?
  pacingDay String?
  timezoneOffsetMinutes Int     @default(0)
  pacedSkips Int                @default(0)
  auctionLosses Int             @default(0)
  lastDeliveredAt DateTime?
  bidMultiplier Decimal         @default(1) @db.Decimal(4, 2)
  reviewStatus AdReviewStatus   @default(APPROVED)
  reviewReason String?          @db.Text
  reviewedAt DateTime?
  reviewedById String?
  media       UserMedia?
  funding     AdFunding[]
  deliveries  AdDelivery[]
  metric      AdBillingMetric
  rate        Decimal          @db.Decimal(12, 4)
  status      AdCampaignStatus @default(DRAFT)
  impressions Int              @default(0)
  clicks      Int              @default(0)
  likes       Int              @default(0)
  comments    Int              @default(0)
  shares      Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation("AdCampaignOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, status, createdAt])
}

model AdFeedDay {
  id String @id
  lastAdId String?
}

model FeedExposure {
  id String @id @default(uuid())
  userId String
  mediaId String
  day String
  createdAt DateTime @default(now())
  @@index([userId, day, mediaId])
}

model AdFunding {
  id String @id @default(cuid())
  campaignId String
  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  requestKey String
  amountCents Int
  provider String @default("STRIPE")
  amountLocalCents Int?
  stripeSessionId String? @unique
  checkoutUrl String? @db.Text
  paidAt DateTime?
  createdAt DateTime @default(now())
  @@unique([campaignId, requestKey])
}

model AdDelivery {
  id String @id @default(uuid())
  campaignId String
  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerId String
  country String
  day String
  createdAt DateTime @default(now())
  pacingReservedMicros BigInt @default(0)
  auctionScore Decimal @default(0) @db.Decimal(16, 6)
  events AdEvent[]
  @@index([viewerId, day, campaignId])
}

model AdEvent {
  id String @id @default(cuid())
  deliveryId String
  delivery AdDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  kind String
  chargeMicros BigInt
  createdAt DateTime @default(now())
  @@unique([deliveryId, kind])
}

model ProviderAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       LoginProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([email])
}

model VerificationCode {
  id         String              @id @default(cuid())
  userId     String?
  recipient  String
  channel    VerificationChannel
  purpose    VerificationPurpose
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  createdAt  DateTime            @default(now())
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([recipient, purpose, channel, expiresAt])
  @@index([userId, purpose, createdAt])
}

model UserMedia {
  id                  String             @id @default(cuid())
  userId              String
  adCampaignId        String?            @unique
  adWebsite           String?
  adCta               String?
  adCtaColor          String?            @db.VarChar(7)
  adCampaign          AdCampaign?        @relation(fields: [adCampaignId], references: [id], onDelete: SetNull)
  kind                MediaKind
  title               String?
  titlePositionX      Float?             @default(0.5)
  titlePositionY      Float?             @default(0.5)
  caption             String?            @db.Text
  description         String?            @db.Text
  containsAi          Boolean            @default(false)
  taggedUserId        String?
  taggedUsername      String?
  taggedUserIds       Json?
  taggedUsernames     Json?
  taggedUserPreviews  Json?
  tagApprovalStatuses Json?
  tagApprovalStatus   TagApprovalStatus?
  objectKey           String?
  url                 String
  images              Json?
  thumbnailUrl        String?
  mimeType            String?
  sizeBytes           Int?
  views               Int                @default(0)
  likes               Int                @default(0)
  commentCount        Int                @default(0)
  shareCount          Int                @default(0)
  repostCount         Int                @default(0)
  saveCount           Int                @default(0)
  isHiddenByOwner     Boolean            @default(false)
  // Copyright moderation: null = visible. UNDER_REVIEW / APPEALED / REMOVED
  // hide the post from everyone except its owner until an admin decides.
  copyrightStatus     String?
  // General content reports (not copyright): null = visible. UNDER_REVIEW
  // hides the post from everyone except its owner pending admin review.
  reportStatus        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  likeRecords         VideoLike[]
  comments            VideoComment[]
  savedBy             SavedVideo[]
  hiddenBy            HiddenMedia[]
  reposts             MediaRepost[]
  reports             Report[]
  analyticsViews      AnalyticsView[]

  @@index([userId, kind])
  @@index([taggedUserId])
}

model AnalyticsView {
  id          String @id
  mediaId     String
  viewerKey   String
  country     String?
  watchMs     Int @default(0)
  durationMs  Int @default(0)
  completed   Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  media       UserMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([mediaId, createdAt])
  @@index([createdAt])
}

model AccountAnalyticsEvent {
  id String @id @default(cuid())
  ownerId String
  kind String
  createdAt DateTime @default(now())
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  @@index([ownerId,kind,createdAt])
}

model AnalyticsReportSchedule {
  userId      String @id
  enabled     Boolean @default(false)
  frequency   Int @default(7)
  nextRunAt   DateTime
  leasedUntil DateTime?
  lastSentAt  DateTime?
  lastError   String?
  updatedAt   DateTime @updatedAt
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

model MediaRepost {
  id        String    @id @default(cuid())
  userId    String
  mediaId   String
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media     UserMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([mediaId, createdAt])
}

model Report {
  id             String     @id @default(cuid())
  reportedUserId String
  reportedById   String?
  mediaId        String?
  message        String     @db.Text
  createdAt      DateTime   @default(now())
  resolvedAt     DateTime?
  target         User       @relation("ReportTarget", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User?      @relation("ReportReporter", fields: [reportedById], references: [id], onDelete: SetNull)
  media          UserMedia? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([reportedUserId])
  @@index([reportedById])
  @@index([mediaId])
}

model TechnicalIssue {
  id          String               @id @default(cuid())
  ticketNumber Int?                @unique
  replies     TechnicalIssueReply[]
  typing      TechnicalIssueTyping[]
  userId      String
  subject     String
  description String               @db.Text
  appVersion  String?
  platform    String?
  status      TechnicalIssueStatus @default(OPEN)
  adminNotes  String?              @db.Text
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  resolvedAt  DateTime?
  userReadAt  DateTime?
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model SupportTicketSequence {
  id    Int @id
  value Int
}

model TechnicalIssueReply {
  id        String @id @default(cuid())
  issueId   String
  authorId  String
  message   String @db.Text
  fromAdmin Boolean
  createdAt DateTime @default(now())
  issue     TechnicalIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt, id])
}

model TechnicalIssueTyping {
  issueId   String
  agentId   String
  expiresAt DateTime
  issue     TechnicalIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@id([issueId, agentId])
}

model PaymentPlan {
  id            String       @id @default(cuid())
  name          String
  code          String       @unique
  description   String?      @db.Text
  amount        Decimal      @db.Decimal(10, 2)
  currency      String       @default("USD")
  interval      PlanInterval @default(MONTHLY)
  intervalCount Int          @default(1)
  isActive      Boolean      @default(true)
  features      Json?
  sortOrder     Int          @default(0)
