model MpesaPaymentRequest {
  id                String             @id @default(cuid())
  userId            String?
  phone             String
  amount            Decimal            @db.Decimal(10, 2)
  merchantRequestId String?            @unique
  checkoutRequestId String?            @unique
  status            MpesaRequestStatus @default(PENDING)
  responsePayload   Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, createdAt])
  @@index([status, createdAt])
}

model WithdrawalRequest {
  id              String         @id @default(cuid())
  userId          String
  amount          Decimal        @db.Decimal(10, 2)
  grossAmountUsd  Decimal?       @db.Decimal(12, 2)
  feeAmountUsd    Decimal?       @db.Decimal(12, 2)
  netAmountUsd    Decimal?       @db.Decimal(12, 2)
  exchangeRate    Decimal?       @db.Decimal(12, 4)
  netAmountKes    Decimal?       @db.Decimal(12, 2)
  quoteExpiresAt  DateTime?
  method          String
  destination     String
  status          String         @default("pending")
  metadata        Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatorPayoutId String?        @unique
  creatorPayout   CreatorPayout? @relation(fields: [creatorPayoutId], references: [id], onDelete: SetNull)
}

model NotificationSound {
  id          String   @id @default(cuid())
  assetKey    String   @unique
  displayName String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model DeviceInstallation {
  id        String   @id @default(cuid())
  userId    String
  platform  String
  fcmToken  String?  @unique
  voipToken String?  @unique
  deviceId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, isActive])
}

model CallInvite {
  id         String           @id @default(uuid())
  bookingId  String
  callerId   String
  calleeId   String
  status     CallInviteStatus @default(RINGING)
  expiresAt  DateTime
  answeredAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  booking    CallBooking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  caller     User             @relation("CallInviteCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User             @relation("CallInviteCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([bookingId, status])
  @@index([calleeId, status, expiresAt])
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  objectKey   String   @unique
  url         String?
  contentType String?
  sizeBytes   Int?
  visibility  String   @default("public")
  bucket      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AppSettings {
  googleOAuthClientIds          String?  @db.Text
  appleOAuthAudiences          String?  @db.Text
  id                           Int      @id @default(1)
  appName                      String   @default("ChatAndTip")
  maxVideosUpload              Int      @default(10)
  freeStorageLimitMb           Int      @default(1024)
  contactEmail                 String?
  contactPhone                 String?
  address                      String?
  currency                     String   @default("USD")
  minimumTip                   Decimal  @default(0) @db.Decimal(10, 2)
  transactionFeePercent        Decimal  @default(0) @db.Decimal(5, 2)
  withdrawalFeePercent         Decimal  @default(0) @db.Decimal(5, 2)
  usdToKesRate                 Decimal  @default(0) @db.Decimal(10, 2)
  freeMemberSwipeLimit         Int      @default(20)
  showDiscoverAdAfterSwipes    Int      @default(5)
  allowVideoModeration         Boolean  @default(false)
  showAds                      Boolean  @default(false)
  allowFreeAccess              Boolean  @default(false)
  allowVideoCall               Boolean  @default(true)
  allowVoiceCall               Boolean  @default(true)
  allowSendImages              Boolean  @default(true)
  adminEmail                   String?
  jwtExpiry                    String   @default("7d")
  mpesaConsumerKey             String?
  mpesaConsumerSecret          String?
  mpesaPasskey                 String?
  mpesaShortcode               String?
  mpesaStoreNumber             String?
  mpesaShortcodeType           String   @default("CustomerPayBillOnline")
  mpesaEnvironment             String   @default("sandbox")
  // Native M-PESA (our own STK-push integration, distinct from M-PESA-via-
  // Paystack below). Previously gated only by credential completeness with
  // no explicit on/off switch — this makes it independently toggleable.
  mpesaEnabled                 Boolean  @default(false)
  // Stripe (delivers Google Pay + cards in the hosted checkout). Managed here
  // so payments can be turned on from the dashboard without a redeploy.
  stripeEnabled                Boolean  @default(false)
  stripeSecretKey              String?
  stripeWebhookSecret          String?
  // Paystack (Google Pay + M-PESA + cards, settles in KES). Primary web/app
  // top-up gateway. Also dashboard-managed.
  paystackEnabled              Boolean  @default(false)
  paystackSecretKey            String?
  paystackPublicKey            String?
  // Independently toggleable Paystack channels — lets card and M-PESA-via-
  // Paystack be turned on/off separately from each other and from the
  // overall paystackEnabled switch above.
  paystackCardEnabled          Boolean  @default(true)
  paystackMpesaEnabled         Boolean  @default(true)
  // Flutterwave (Google Pay only — Paystack has no Google Pay support at
  // all). v4 API: OAuth2 client-credentials auth, so we store a client
  // id/secret pair rather than a single secret key. Base URL is dashboard-
  // editable because v4 is a new API and Flutterwave's sandbox/production
  // hosts have moved between docs revisions — safer than hardcoding it.
  flutterwaveEnabled           Boolean  @default(false)
  flutterwaveClientId          String?
  flutterwaveClientSecret      String?
  flutterwaveSecretHash        String?
  flutterwaveBaseUrl           String   @default("https://developersandbox-api.flutterwave.com")
  flutterwaveCurrency          String   @default("KES")
  // Google Play Billing (Android only) — the actual Play Store compliance
  // path for digital goods, distinct from Google Pay (a payment method, not
  // a store policy). Service account JSON is how the server verifies/
  // consumes purchases via the Android Publisher API; it's large, hence Text
  // rather than the VARCHAR(191) used for other secrets here.
  googlePlayEnabled            Boolean  @default(false)
  googlePlayPackageName        String   @default("com.chatandtip.app")
  googlePlayServiceAccountJson String?  @db.Text
  paypalClientId               String?
  paypalClientSecret           String?
  r2AccountId                  String?
  r2AccessKeyId                String?
  r2SecretAccessKey            String?
  r2BucketName                 String?
  r2PrivateBucketName          String?
  r2PublicBaseUrl              String?
  r2Region                     String   @default("auto")
  r2Endpoint                   String?
  emailEnabled                 Boolean  @default(false)
  smtpHost                     String?
  smtpPort                     Int      @default(587)
  smtpSecure                   Boolean  @default(false)
  smtpUser                     String?
  smtpPassword                 String?
  smtpFromAddress              String?
  smtpFromName                 String?
  smsEnabled                   Boolean  @default(false)
  smsApiUrl                    String   @default("https://smsportal.hostpinnacle.co.ke/SMSApi/send")
  smsUserId                    String?
  smsPassword                  String?
  smsSenderId                  String?
  otpLength                    Int      @default(6)
  otpExpiryMinutes             Int      @default(10)
  passwordResetExpiryMinutes   Int      @default(15)
  awsAccessKeyId               String?
  awsSecretAccessKey           String?
  awsRegion                    String   @default("us-east-1")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model SavedVideo {
  id      String    @id @default(cuid())
  userId  String
  mediaId String
  savedAt DateTime  @default(now())
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media   UserMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, savedAt])
}

// A viewer-level preference: unlike moderation or an owner hiding their own
// work, this affects only the account that selected "Not interested".
model HiddenMedia {
  id       String    @id @default(cuid())
  userId   String
  mediaId  String
  hiddenAt DateTime  @default(now())
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  media    UserMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([userId, mediaId])
  @@index([userId, hiddenAt])
}

model UserKey {
  id        String   @id @default(cuid())
  userId    String   @unique
  publicKey String   @db.Text
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Public contact-us submissions (contact.chatandtip.com). Persisted so a
// message isn't lost if outbound email is disabled or misconfigured — email
// notifies the admin inbox, this table is the record of truth.
model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  address   String   @db.Text
  email     String
  phone     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model QrSignInChallenge {
  id             String    @id @default(cuid())
  pollHash       String    @db.VarChar(64)
  approvalHash   String    @db.VarChar(64)
  approvedUserId String?
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())
  @@index([expiresAt])
}

// Referral and vault entitlements are isolated from ordinary chat/post storage.
model VaultReferralAccount {
  userId String @id @db.VarChar(191)
  code String @unique @db.VarChar(24)
  bonusAwardedAt DateTime?
  celebrationSeenAt DateTime?
  createdAt DateTime @default(now())
}

model VaultReferral {
  id String @id @default(cuid())
  referrerUserId String @db.VarChar(191)
  referredUserId String @unique @db.VarChar(191)
  completedAt DateTime?
  createdAt DateTime @default(now())
  @@index([referrerUserId, completedAt])
}

model VaultStoragePlan {
  id String @id @default(cuid())
  name String @db.VarChar(100)
  capacityBytes BigInt
  interval String @db.VarChar(16)
  priceCents Int?
  currency String @default("USD") @db.VarChar(3)
  appleProductId String? @unique @db.VarChar(191)
  googleProductId String? @unique @db.VarChar(191)
  active Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([capacityBytes, interval])
}

model VaultStorageEntitlement {
  id String @id @default(cuid())
  userId String @db.VarChar(191)
  planId String @db.VarChar(191)
  capacityBytes BigInt
  provider String @db.VarChar(24)
  providerReference String @unique @db.VarChar(191)
  providerData String? @db.Text
  lastVerifiedAt DateTime?
  status String @db.VarChar(24)
  startsAt DateTime
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, expiresAt])
}

model VaultUploadLedger {
  id String @id @default(cuid())
  userId String @db.VarChar(191)
  objectKey String @db.VarChar(1024)
  objectKeyHash String @unique @db.Char(64)
  sizeBytes BigInt
  state String @db.VarChar(24)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, state])
}

model VaultStoreConfig {
  id Int @id @default(1)
  appleIssuerId String? @db.VarChar(191)
  appleKeyId String? @db.VarChar(191)
  applePrivateKeyEncrypted String? @db.Text
  androidAppLinkSha256 String? @db.Text
  updatedAt DateTime @updatedAt
}
