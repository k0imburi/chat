model UserNotification {
  id        String    @id @default(cuid())
  userId    String
  senderId  String?
  title     String?
  message   String    @db.Text
  type      String    @default("alert")
  isRead    Boolean   @default(false)
  hiddenAt  DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation("UserNotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  sender    User?     @relation("UserNotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

